[Unit]
Description=PulseLinux System Vitals & Diagnostics Daemon
Documentation=https://github.com/nandhu/tuxMonitor
After=network.target

[Service]
Type=simple
User=vitals-daemon
Group=vitals-daemon
WorkingDirectory=/home/nandhu/projects/system-vitals-monitor/backend
EnvironmentFile=-/etc/default/pulse-vitals-daemon
ExecStart=/home/nandhu/projects/system-vitals-monitor/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 15000 --no-access-log --workers 1
Restart=always
RestartSec=3

# Resource Limits to ensure daemon remains responsive and stable
MemoryMax=512M
MemoryHigh=384M
CPUQuota=60%
Nice=5
TasksMax=200

[Install]
WantedBy=multi-user.target
